# Supabase
# Painel do projeto: Settings > API Keys
# Use a "Publishable key" (aba "API Keys", formato sb_publishable_...) — recomendado
# Se seu projeto só tiver a aba "Legacy API Keys", use a chave "anon" por enquanto
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL do backend
VITE_API_URL=http://localhost:3000

# --- Segurança (Etapa 16) ---

# CAPTCHA (Cloudflare Turnstile) no login, cadastro e "esqueci minha senha".
# Vazio = desligado. Ligue SEMPRE junto com o Supabase (Authentication >
# Attack Protection), senão o login falha. Para testar sem conta no
# Cloudflare: 1x00000000000000000000AA (sempre aprova; mostra "teste").
VITE_TURNSTILE_SITE_KEY=

# Minutos sem uso até a sessão ser encerrada (padrão 15, mínimo 2).
VITE_IDLE_TIMEOUT_MINUTES=15
