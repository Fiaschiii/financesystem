# Porta do servidor backend
PORT=3000

# URL do frontend (usada para configurar o CORS)
FRONTEND_URL=http://localhost:5173

# Ambiente. Em "production" as respostas de erro 500 não mostram o detalhe
# técnico (mensagem do banco etc.). Deixe vazio no seu computador.
NODE_ENV=

# --- Limites de requisições (Etapa 17) ---
# Vazio = padrão. Quem passa do limite recebe 429 e o tempo de espera.

# Requisições por IP a cada 15 minutos (padrão: 300)
RATE_LIMIT_MAX=
# Requisições por IP em 1 minuto, contra rajadas (padrão: 60)
RATE_LIMIT_BURST=
# Respostas "login inválido" (401) por IP a cada 15 minutos (padrão: 30)
RATE_LIMIT_AUTH_FAILURES=
# Gravações (criar, editar, excluir) por usuário em 1 minuto (padrão: 30)
RATE_LIMIT_WRITES=
# Testes de conexão com o banco (/api/health/supabase) por IP em 1 minuto (padrão: 10)
RATE_LIMIT_HEALTH_DB=

# Só se o backend estiver atrás de um proxy (Nginx, Render, Railway...):
# quantos proxies há na frente (normalmente 1). Sem proxy, deixe vazio.
TRUST_PROXY=

# Supabase
# Painel do projeto: Settings > API Keys
# Use a "Publishable key" (aba "API Keys", formato sb_publishable_...) — recomendado
# Se seu projeto só tiver a aba "Legacy API Keys", use a chave "anon" por enquanto
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NÃO coloque aqui a chave "secret" (antiga service_role): ela ignora o RLS.
# O backend não precisa dela — todas as consultas usam o login do próprio
# usuário, e é isso que faz o RLS valer.
